{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "E-commerce backend with TypeScript, Node.js, and TypeORM",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "seed": "ts-node src/seed.ts",
    "users": "ts-node src/printUsers.ts",
    "test": "jest",
    "test:integration": "jest --runInBand --runTestsByPath src/__tests__/integration/apiDatabase.integration.test.ts --testPathIgnorePatterns=src/__tests__/unit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}

PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=ecommerce

# Generate a random value of at least 32 characters for signed sessions.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Admin is provisioned from the server environment and cannot self-register.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
